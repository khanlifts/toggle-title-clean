{
  "manifest_version": 3,
  "name": "Toggle Title",
  "version": "1.0",
  "description": "Toggle the display of the title of the Chrome Extension documentation by button click.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "run_at": "document_start"
    }
  ]
}